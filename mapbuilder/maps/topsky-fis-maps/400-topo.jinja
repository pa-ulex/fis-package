//---------------------------------------------------------------
//                            Topography
//---------------------------------------------------------------

MAP:Topography
FOLDER:Topo
LAYER:-2
STYLE:Solid:1
TEXTALIGN:LC
{% for uuid, geom in data.urban_areas.items() %}
{{- geom | to_poly('', 'topo_urban', 100) }}
{% endfor %}
COLOR:topo_road
{% for uuid, geom in data.autobahn.items() %}
{{- geom | to_coordline('') }}
{% endfor %}
{% for label, geom in data.autobahn_labels.items() %}
{{- geom | to_text(label) }}
{% endfor %}
COLOR:topo_water
{% for uuid, geom in data.rivers.items() %}
{{- geom | to_coordline('') }}
{% endfor %}
{% for label, geom in data.rivers_labels.items() %}
{{- geom | to_text(label) }}
{% endfor %}
{% for name, geom in data.lakes.items() %}
{{- geom | to_poly(name, 'topo_water', 100) }}
{% endfor %}

MAP:Coastline
FOLDER:Topo
LAYER:-2
STYLE:Solid:1
COLOR:standard
{{ data.coastline }}

MAP:Urban Areas
FOLDER:Topo
LAYER:-2
STYLE:Solid:1
{% for uuid, geom in data.urban_areas.items() %}
{{- geom | to_poly(name, 'topo_urban', 100) }}
{% endfor %}

MAP:Highways
FOLDER:Topo
LAYER:-2
