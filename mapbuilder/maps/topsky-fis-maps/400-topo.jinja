COLOR:topo_road
{% for uuid, geom in data.autobahn.items() %}
{{- geom | to_coordline('') }}
{% endfor %}
{% for label, geom in data.rivers_labels.items() %}
{{- geom | to_text(label) }}
{% endfor %}

MAP:Rivers and Lakes
FOLDER:Topo
LAYER:-2
STYLE:Solid:1
COLOR:topo_water
{% for uuid, geom in data.rivers.items() %}
{{- geom | to_coordline('') }}
{% endfor %}
{% for name, geom in data.lakes.items() %}
{{- geom | to_poly(name, 'topo_water', 100) }}
{% endfor %}
{% for label, geom in data.rivers_labels.items() %}
{{- geom | to_text(label) }}
{% endfor %}

MAP:German Border
FOLDER:Topo
LAYER:-3
STYLE:Solid:1
COLOR:standard
{% for uuid, geom in data.border.items() %}
{{- geom | to_coordline(uuid) }}
{% endfor %}